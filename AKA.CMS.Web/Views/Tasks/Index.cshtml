@{
    ViewData["Title"] = "Tasks & Assignments";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "tasks";
    ViewData["RequiredPermission"] = "Tasks:Read";
}

<div class="page-head">
  <div><h1>Tasks &amp; Assignments</h1><p>Track work assigned to your team.</p></div>
  <div class="page-actions" data-permission="Tasks:Write">
    <a class="btn primary" href="@Url.Action("Create", "Tasks")">Create New Task</a>
  </div>
</div>

<div class="card"><h3>Task Queue</h3>
  <div class="filters">
    <select id="taskPriority"><option value="">All priorities</option><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select>
    <select id="taskDue"><option value="">All due dates</option><option value="today">Due today</option><option value="overdue">Overdue</option></select>
  </div>
  <div class="table-wrap"><table class="table" id="taskTable">
    <thead><tr><th>Task</th><th>Patient / Case</th><th>Priority</th><th>Due</th><th></th></tr></thead>
    <tbody id="taskRows"><tr><td colspan="5"><div class="empty">Loading&hellip;</div></td></tr></tbody>
  </table></div>
</div>

@section Scripts {
<script src="~/js/view/tasks.js" asp-append-version="true"></script>
}
