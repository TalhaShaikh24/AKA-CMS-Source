@{
    ViewData["Title"] = "Create Task";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "tasks";
    ViewData["RequiredPermission"] = "Tasks:Write";
}

<div class="page-head"><div><h1>Create Task</h1></div></div>

<div class="steps" id="taskSteps">
  <div class="step current" data-step="1"><span class="circle">1</span>Task Details</div><div class="step-line"></div>
  <div class="step" data-step="2"><span class="circle">2</span>Assign To</div><div class="step-line"></div>
  <div class="step" data-step="3"><span class="circle">3</span>Review &amp; Create</div>
</div>

<form id="taskForm" data-validate novalidate>
  <!-- STEP 1 -->
  <div data-pane="1">
    <div class="card"><h3>1. Task Details</h3>
      <div class="form-grid">
        <div class="field"><label for="tTitle">Task Title <span class="req">*</span></label><input class="input" id="tTitle" maxlength="200" placeholder="Complete PHQ-9 assessment" required><span class="field-error"></span></div>
        <div class="field"><label for="tType">Task Type</label><select class="input select2" id="tType"><option>Clinical Assessment</option><option>Follow-up Call</option><option>Screening</option><option>Referral Review</option><option>Home Visit</option><option>Documentation</option><option>Other</option></select><span class="field-error"></span></div>
        <div class="field full"><label for="tDesc">Description / Instructions</label><textarea class="input" id="tDesc" rows="3" maxlength="4000" placeholder="Free text"></textarea><span class="field-error"></span></div>
        <div class="field"><label for="tCase">Case / Patient <span class="req">*</span></label><select class="input select2" id="tCase" style="width:100%" required></select><span class="field-error"></span></div>
        <div class="field"><label for="tPriority">Priority</label><select class="input select2" id="tPriority"><option>Low</option><option selected>Medium</option><option>High</option><option>Urgent</option></select><span class="field-error"></span></div>
        <div class="field"><label for="tDue">Due Date <span class="req">*</span></label><input class="input" id="tDue" type="date" required><span class="field-error"></span></div>
      </div>
      <div class="bottom-actions">
        <a class="btn secondary" href="@Url.Action("Index", "Tasks")">Cancel</a>
        <button class="btn primary" id="toStep2" type="button">Next</button>
      </div>
    </div>
  </div>

  <!-- STEP 2 -->
  <div data-pane="2" hidden>
    <div class="card"><h3>2. Assign To</h3>
      <div class="form-grid">
        <div class="field"><label for="tRole">Role</label><select class="input select2" id="tRole"><option value="">Select role&hellip;</option></select><span class="field-error"></span></div>
        <div class="field"><label for="tUser">User</label><select class="input select2" id="tUser"><option value="">Select user&hellip;</option></select><span class="field-error"></span></div>
      </div>
      <h3 style="margin-top:22px">Additional Recipients for Approval</h3>
      <div class="checkbox-row">
        <label class="check"><input type="checkbox" id="nHc" checked> Notify Helpline Coordinator</label>
        <label class="check"><input type="checkbox" id="nCc"> Notify Clinical Coordinator</label>
        <label class="check"><input type="checkbox" id="nPc"> Notify Programme Manager</label>
      </div>
      <div class="notice" style="margin-top:18px">This task will also be visible to the assigned user's team based on their role permissions.</div>
      <div class="bottom-actions">
        <button class="btn secondary" id="backTo1" type="button">Back</button>
        <button class="btn primary" id="toStep3" type="button">Next</button>
      </div>
    </div>
  </div>

  <!-- STEP 3 -->
  <div data-pane="3" hidden>
    <div class="card"><h3>3. Review &amp; Create</h3>
      <div class="kv" id="reviewBox"></div>
      <div class="bottom-actions">
        <button class="btn secondary" id="backTo2" type="button">Back</button>
        <button class="btn primary" id="createTaskBtn" type="button">Assign Task</button>
      </div>
    </div>
  </div>

  <!-- SUCCESS -->
  <div data-pane="4" hidden>
    <div class="hero-success">
      <div class="success-icon">✓</div>
      <h1>Task Successfully Assigned!</h1>
      <p class="hint" id="successMsg"></p>
      <p><b id="successTaskId"></b></p>
      <div class="success-actions">
        <a class="btn primary" href="@Url.Action("Index", "Tasks")">Back to Tasks</a>
        <a class="btn secondary" href="@Url.Action("Create", "Tasks")">Create Another</a>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script src="~/js/view/task-create.js" asp-append-version="true"></script>
}
