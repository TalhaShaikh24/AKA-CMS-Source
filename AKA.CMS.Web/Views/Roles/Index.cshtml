@{
    ViewData["Title"] = "Roles & Permissions";
    ViewData["ActivePage"] = "roles";
    ViewData["RequiredPermission"] = "Roles:Read";
}
<style>
  .rp-grid{display:grid;grid-template-columns:320px 1fr;gap:20px;align-items:start}
  @@media(max-width:900px){.rp-grid{grid-template-columns:1fr}}
  .role-item{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid #e6eaf2;border-radius:10px;margin-bottom:10px;cursor:pointer;background:#fff}
  .role-item.active{border-color:#3b5bdb;box-shadow:0 0 0 2px rgba(59,91,219,.12)}
  .role-item strong{display:block;font-size:14px}
  .perm-group{margin-bottom:18px}
  .perm-group h4{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:#6b7280;margin:0 0 8px}
  .perm-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid #eef1f6;border-radius:8px;margin-bottom:6px;background:#fbfcfe}
  .perm-row .pa{font-family:ui-monospace,monospace;font-size:12.5px}
  .switch{position:relative;width:38px;height:22px;flex:none}
  .switch input{opacity:0;width:0;height:0}
  .slider{position:absolute;cursor:pointer;inset:0;background:#cbd5e1;border-radius:22px;transition:.2s}
  .slider:before{position:absolute;content:"";height:16px;width:16px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s}
  .switch input:checked + .slider{background:#3b5bdb}
  .switch input:checked + .slider:before{transform:translateX(16px)}
  .modal{max-width:440px}
</style>

<div class="page-head">
  <div class="page-title">
    <h1>Roles &amp; Permissions</h1>
    <p class="sub">Define roles and control what each role can access</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-primary" id="addRoleBtn" type="button">+ New Role</button>
  </div>
</div>

<div class="rp-grid">
  <div class="card">
    <div class="card-head"><h3>Roles</h3><span class="hint" id="roleCount"></span></div>
    <div class="card-body" id="roleList"></div>
  </div>
  <div class="card">
    <div class="card-head"><h3 id="permTitle">Permissions</h3><span class="hint">toggle to grant / revoke</span></div>
    <div class="card-body" id="permBody">
      <p class="hint">Select a role to manage its permissions.</p>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="roleModalNew">
  <div class="modal">
    <div class="modal-head">
      <h3 id="roleModalTitle">New Role</h3>
      <button class="modal-x" data-close type="button">&times;</button>
    </div>
    <form id="roleForm" data-validate novalidate>
      <div class="modal-body">
        <div class="field">
          <label>Role Name <span class="req">*</span></label>
          <input class="input" id="nrDesc" required placeholder="e.g. Field Worker" maxlength="200">
          <span class="field-error"></span>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close type="button">Cancel</button>
        <button class="btn btn-primary" type="submit" id="roleFormSubmit">Create Role</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script src="~/js/view/roles.js" asp-append-version="true"></script>
}
