@{
    ViewData["Title"] = "Appointments";
    ViewData["ActivePage"] = "appointments";
}
<style>
  .week-nav{display:flex;gap:8px}
  .appt-actions{display:flex;gap:8px;flex-wrap:wrap}
  .mode-pills{display:flex;gap:10px;flex-wrap:wrap}
  .mode-pills .mode-pill{cursor:pointer;display:inline-flex;align-items:center;gap:8px}
  .mode-pills input{accent-color:var(--navy)}
</style>

<div class="page-head">
  <div class="page-title">
    <h1>Appointments</h1>
    <p class="sub">Schedule and manage consultations</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost filter-toggle-btn" id="filterToggle" type="button" aria-expanded="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.5 10 19 14 21 14 12.5 22 3"/></svg>
      Filters
      <span class="filter-count" id="filterCount" hidden>0</span>
    </button>
    <button class="btn btn-primary" id="bookBtn" type="button">+ Book Appointment</button>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h3 id="weekLabel">This week</h3>
    <div class="week-nav">
      <button class="btn btn-ghost btn-sm" id="weekPrev" type="button">&#8249; Prev</button>
      <button class="btn btn-ghost btn-sm" id="weekNext" type="button">Next &#8250;</button>
    </div>
  </div>
  <div class="card-body">
    <div class="week-strip" id="weekStrip"></div>
  </div>
</div>

<div class="filter-panel" id="apptFilterPanel" hidden>
  <div class="filters-bar" id="apptFilters"></div>
  <div class="filter-panel-foot">
    <button class="btn btn-ghost btn-sm" id="apptClearFilters" type="button">Clear</button>
    <button class="btn btn-primary btn-sm" id="apptApplyFilters" type="button">Apply Filters</button>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h3>Scheduled Appointments</h3>
    <span class="hint" id="apptCount"></span>
  </div>
  <div class="card-body">
    <div id="apptList"></div>
  </div>
</div>

<div class="modal-backdrop" id="bookModal">
  <div class="modal">
    <div class="modal-head">
      <h3>Book Appointment</h3>
      <button class="modal-x" data-close type="button">&times;</button>
    </div>
    <form id="bookForm" data-validate novalidate>
      <div class="modal-body">
        <div class="form-grid">
          <div class="field">
            <label>Patient <span class="req">*</span></label>
            <select class="input select2" id="bkPatient" required><option value=""></option></select>
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label>Appointment Type <span class="req">*</span></label>
            <select class="input select2" id="bkType" required>
              <option value=""></option>
              <option>Psychological Session</option>
              <option>Follow-up</option>
              <option>Intake Assessment</option>
              <option>Crisis Review</option>
              <option>Safety Plan Review</option>
              <option>Family Session</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label>Date <span class="req">*</span></label>
            <input class="input cms-date" id="bkDate" required placeholder="Select date" autocomplete="off">
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label>Time <span class="req">*</span></label>
            <select class="input" id="bkTime" required>
              <option value=""></option>
              <option>09:00 AM</option>
              <option>09:30 AM</option>
              <option>10:00 AM</option>
              <option>10:30 AM</option>
              <option>11:00 AM</option>
              <option>11:30 AM</option>
              <option>12:00 PM</option>
              <option>12:30 PM</option>
              <option>02:00 PM</option>
              <option>02:30 PM</option>
              <option>03:00 PM</option>
              <option>03:30 PM</option>
              <option>04:00 PM</option>
              <option>04:30 PM</option>
              <option>05:00 PM</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="field full">
            <label>Mode</label>
            <div class="mode-pills">
              <label class="mode-pill"><input type="radio" name="bkMode" value="In-person" checked><span>In-person</span></label>
              <label class="mode-pill tele"><input type="radio" name="bkMode" value="Teleconsultation"><span>Teleconsultation</span></label>
            </div>
          </div>
          <div class="field">
            <label>Location</label>
            <select class="input" id="bkLocation">
              <option>Counseling Room 1</option>
              <option>Counseling Room 2</option>
              <option>Counseling Room 3</option>
              <option>Video Link</option>
            </select>
          </div>
          <div class="field">
            <label>Duration</label>
            <select class="input" id="bkDuration">
              <option>30 minutes</option>
              <option selected>45 minutes</option>
              <option>60 minutes</option>
            </select>
          </div>
          <div class="field full">
            <label>Notes</label>
            <textarea class="input" id="bkNotes" rows="3" placeholder="Optional notes for the clinician"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close type="button">Cancel</button>
        <button class="btn btn-primary" type="submit">Book Appointment</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script src="~/js/view/appointments.js" asp-append-version="true"></script>
}
