@{
    ViewData["Title"] = "Follow-ups";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "appointments";
    ViewData["RequiredPermission"] = "FollowUps:Read";
}

<div class="page-head">
  <div><h1>Follow-ups</h1><p>Upcoming, overdue and missed appointments.</p></div>
  <div class="page-actions">
    <button class="btn btn-primary" id="bookBtn" type="button" data-permission="FollowUps:Write">+ Schedule Follow-up</button>
  </div>
</div>

<div class="filters">
  <select id="followFilter"><option value="">All follow-ups</option><option>Upcoming</option><option>Due Today</option><option>Overdue</option><option>Missed Appointment</option></select>
</div>

<div class="card"><h3>Follow-up Queue</h3>
  <div class="table-wrap"><table class="table" id="followTable">
    <thead><tr><th>Patient</th><th>Date</th><th>Assigned To</th><th>Status</th><th></th></tr></thead>
    <tbody id="followRows"><tr><td colspan="5"><div class="empty">Loading&hellip;</div></td></tr></tbody>
  </table></div>
</div>

<div class="modal-backdrop" id="bookModal">
  <div class="modal">
    <div class="modal-head"><h3>Schedule Follow-up</h3><button class="modal-x" data-close type="button">&times;</button></div>
    <form id="bookForm" data-validate novalidate>
      <div class="modal-body">
        <div class="form-grid">
          <div class="field"><label for="bCase">Case *</label><select class="input" id="bCase" required><option value="" selected disabled>Select case</option></select><span class="field-error"></span></div>
          <div class="field"><label for="bDate">Date *</label><input class="input" type="date" id="bDate" required><span class="field-error"></span></div>
          <div class="field"><label for="bType">Type</label><select class="input" id="bType"><option>Phone</option><option>In-person</option><option>Home visit</option></select><span class="field-error"></span></div>
          <div class="field full"><label for="bNotes">Notes</label><textarea class="input" id="bNotes" rows="3"></textarea><span class="field-error"></span></div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close type="button">Cancel</button>
        <button class="btn btn-primary" type="submit">Schedule</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script src="~/js/view/appointments.js" asp-append-version="true"></script>
}
