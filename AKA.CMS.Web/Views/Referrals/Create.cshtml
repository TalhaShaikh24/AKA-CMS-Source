@{
    ViewData["Title"] = "Create Referral";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "referrals";
    ViewData["RequiredPermission"] = "Referrals:Write";
}

<div class="page-head"><div><h1>Create Referral</h1></div></div>

<div class="steps" id="refSteps">
  <div class="step current" data-step="1"><span class="circle">1</span>Referral Details</div><div class="step-line"></div>
  <div class="step" data-step="2"><span class="circle">2</span>Select Provider</div><div class="step-line"></div>
  <div class="step" data-step="3"><span class="circle">3</span>Review &amp; Submit</div>
</div>

<form id="refForm" data-validate novalidate>
  <div class="ref-step" id="rf1">
    <div class="card"><h3>1. Referral Details</h3>
      <div class="form-grid">
        <div class="field"><label for="rCase">Case <span class="req">*</span></label><select class="input select2" id="rCase" required><option value="" selected disabled>Select case</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rService">Referral Destination / Service <span class="req">*</span></label><select class="input select2" id="rService" required><option value="" selected disabled>Select service</option><option>Psychologist</option><option>Psychiatrist/GP</option><option>Social Welfare Board (SWB)</option><option>Crisis Services</option><option>Community Resources</option><option>Institutional Volunteers (IV)</option><option>Other</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rToPsych">Referral to Psychologist</label><select class="input select2" id="rToPsych"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
        <div class="field full"><label for="rReason">Referral Reason <span class="req">*</span></label><textarea class="input" id="rReason" placeholder="Free text" required></textarea><span class="field-error"></span></div>
        <div class="field"><label for="rPriority">Referral Urgency <span class="req">*</span></label><select class="input select2" id="rPriority" required><option value="" selected disabled>Select urgency</option><option>Emergency</option><option>Urgent</option><option>Routine</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rConsent">Consent for Referral</label><select class="input select2" id="rConsent"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option><option>N/A</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rDate">Date of Referral</label><input class="input" type="date" id="rDate"><span class="field-error"></span></div>
        <div class="field"><label for="rProvider">Name of Psychologist / Provider</label><input class="input" id="rProvider" placeholder="Free text"><span class="field-error"></span></div>
        <div class="field"><label for="rApptDate">Appointment Date</label><input class="input" type="date" id="rApptDate"><span class="field-error"></span></div>
        <div class="field"><label for="rApptStatus">Appointment Status</label><select class="input select2" id="rApptStatus"><option value="" selected disabled>Select status</option><option>Scheduled</option><option>Attended</option><option>Missed</option><option>Rescheduled</option><option>Cancelled</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rOtherRef">Other Referrals</label><select class="input select2" id="rOtherRef"><option value="" selected disabled>Select option</option><option>Emotional support provided</option><option>Referral — Social Welfare Board (SWB)</option><option>Referral — Crisis Services</option><option>Referral — Community Resources</option><option>Referral — Institutional Volunteers (IV)</option><option>Safety plan completed</option><option>Supervisor consultation</option><option>Emergency services contacted</option><option>Follow-up scheduled</option><option>Other</option></select><span class="field-error"></span></div>
        <div class="field"><label for="rOtherRefSpecify">Specify Other Referral</label><input class="input" id="rOtherRefSpecify" placeholder="Free text"><span class="field-error"></span></div>
        <div class="field full"><label for="rSummary">Clinical Summary</label><textarea class="input" id="rSummary" placeholder="Free text"></textarea><span class="field-error"></span></div>
      </div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" data-go="/Referrals">Cancel</button>
        <button type="button" class="btn primary" id="rfNext1">Next</button>
      </div>
    </div>
  </div>

  <div class="ref-step" id="rf2" hidden>
    <div class="card"><h3>2. Select Provider</h3>
      <input class="search" id="provSearch" placeholder="Search by name" style="width:100%;margin-bottom:15px">
      <div class="grid" id="provList" style="gap:12px"></div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" id="rfBack2">Back</button>
        <button type="button" class="btn primary" id="rfNext2">Next</button>
      </div>
    </div>
  </div>

  <div class="ref-step" id="rf3" hidden>
    <div class="card"><h3>3. Review &amp; Submit</h3>
      <div class="kv" id="refReview"></div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" id="rfBack3">Back</button>
        <button type="button" class="btn primary" id="rfSubmit">Submit Referral</button>
      </div>
    </div>
  </div>
</form>

@section Scripts {
<script src="~/js/view/referral-create.js" asp-append-version="true"></script>
}
