@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "dashboard";
}

<div class="page-head">
  <div><h1>Dashboard</h1><p id="dashSub">Here is your case management overview.</p></div>
</div>

<div class="alert" id="crisisAlert" hidden>
  <strong><span id="crisisCount">0</span> Active Crisis Case(s)</strong>
  Requires immediate attention
  <button class="btn small danger" type="button" id="openCrisisBtn">Open Crisis Case</button>
</div>

<div class="grid grid-4" style="margin-top:18px">
  <div class="stat"><div class="num" id="stNew">—</div><div class="label">New Cases</div></div>
  <div class="stat"><div class="num" id="stActive">—</div><div class="label">Active Cases</div></div>
  <div class="stat"><div class="num" id="stFollowups">—</div><div class="label">Follow-ups Due</div></div>
  <div class="stat"><div class="num" id="stLtfu">—</div><div class="label">LTFU Cases</div></div>
</div>

<div class="grid grid-3" style="margin-top:20px">
  <div class="card"><h3>My Cases</h3><p>View and manage your assigned cases.</p><button class="btn primary" data-go="/Cases">Open My Cases</button></div>
  <div class="card"><h3>Follow-ups</h3><p>View upcoming, overdue and missed follow-ups.</p><button class="btn primary" data-go="/Appointments">Open Follow-ups</button></div>
  <div class="card"><h3>Referrals</h3><p>View referral status and provider actions.</p><button class="btn primary" data-go="/Referrals">Open Referrals</button></div>
</div>

<div class="grid grid-2" style="margin-top:20px">
  <div class="card"><h3>Recent Activity</h3><div class="timeline" id="recentActivity"><div class="empty">Loading&hellip;</div></div></div>
  <div class="card"><h3>Quick Actions</h3>
    <div class="grid grid-2">
      <button class="btn primary" data-go="/Cases/Add">Register New Case</button>
      <button class="btn secondary" data-go="/Referrals/Create">Create Referral</button>
      <button class="btn secondary" data-go="/Tasks/Create">Create Task</button>
      <button class="btn danger" data-go="/Crisis">Crisis Protocol</button>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/view/dashboard.js" asp-append-version="true"></script>
}
