@{
    ViewData["Title"] = "Case Details";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "cases";
    ViewData["RequiredPermission"] = "Cases:Read";
}

<div class="page-head">
  <div><h1>Case Details</h1><p id="cdSub">Loading&hellip;</p></div>
  <div class="page-actions">
    <button class="btn btn-ghost" id="editCaseBtn" type="button" data-permission="Cases:Write">Edit Case</button>
  </div>
</div>

<div class="detail-grid">
  <div>
    <div class="card"><h3>Patient Information</h3><div class="kv" id="cdPatientKv"><div class="hint">Loading&hellip;</div></div></div>
    <div class="card"><h3>Current Service</h3><div class="kv" id="cdServiceKv"><div class="hint">Loading&hellip;</div></div></div>
    <div class="card"><h3>Screening Results</h3><div id="cdScreenings"><div class="hint">Loading&hellip;</div></div></div>
    <div class="card"><h3>Risk Assessment</h3><div class="kv" id="cdRiskAssessmentKv"><div class="hint">Loading&hellip;</div></div></div>
    <div class="card"><h3>Case Actions</h3>
      <div class="grid grid-2">
        <button class="btn danger" data-go-crisis>Crisis Protocol</button>
        <button class="btn secondary" data-go="/Screening">Risk Assessment</button>
        <button class="btn secondary" data-go-timeline>Case Timeline</button>
        <button class="btn secondary" data-go="/Referrals/Create">Referrals</button>
        <button class="btn secondary" data-go="/SafetyPlans">Safety Plan</button>
        <button class="btn secondary" data-go="/Appointments">Follow-ups</button>
      </div>
    </div>
  </div>
  <div>
    <div class="card"><h3>Current Risk</h3><div id="cdRiskBox"><div class="hint">Loading&hellip;</div></div></div>
    <div class="card"><h3>Recent Timeline</h3>
      <div class="timeline" id="cdTimeline"><div class="hint">Loading&hellip;</div></div>
      <div style="margin-top:14px"><button class="btn secondary" data-go-timeline style="width:100%">View Full Timeline</button></div>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="editCaseModal">
  <div class="modal">
    <div class="modal-head">
      <h3>Edit Case</h3>
      <button class="modal-x" data-close type="button" aria-label="Close">&times;</button>
    </div>
    <form id="editCaseForm" data-validate novalidate>
      <div class="modal-body">
        <div class="field">
          <label for="ecPriority">Priority</label>
          <select class="input" id="ecPriority">
            <option value="">Select&hellip;</option>
            <option>High</option>
            <option>Moderate</option>
            <option>Low</option>
          </select>
        </div>
        <div class="field">
          <label for="ecNotes">Notes</label>
          <textarea class="input" id="ecNotes" rows="4" placeholder="Case notes&hellip;"></textarea>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close type="button">Cancel</button>
        <button class="btn btn-primary" type="submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="editScreeningModal">
  <div class="modal" style="max-width:640px">
    <div class="modal-head">
      <h3 id="esTitle">Edit Screening</h3>
      <button class="modal-x" data-close type="button" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body"><div id="esQuestions"></div></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" data-close type="button">Cancel</button>
      <button class="btn btn-primary" id="esSave" type="button">Save Changes</button>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/screening-questions.js" asp-append-version="true"></script>
<script src="~/js/view/case-details.js" asp-append-version="true"></script>
}
