@{
    ViewData["Title"] = "Register New Case";
    ViewData["Breadcrumb"] = "Case";
    ViewData["ActivePage"] = "cases-add";
    ViewData["RequiredPermission"] = "Cases:Write";
}

<div class="page-head">
  <div><h1>Register New Case</h1><p>Create a new case and complete the initial assessment.</p></div>
</div>

<div class="steps" id="regSteps">
  <div class="step current" data-step="1"><span class="circle">1</span>Personal Info</div><div class="step-line"></div>
  <div class="step" data-step="2"><span class="circle">2</span>Risk Assessment</div><div class="step-line"></div>
  <div class="step" data-step="3"><span class="circle">3</span>Screening</div><div class="step-line"></div>
  <div class="step" data-step="4"><span class="circle">4</span>Review</div>
</div>

<form id="regForm" data-validate novalidate>
  <!-- STEP 1: Personal Info -->
  <div class="reg-step" id="rs1">
    <div class="card"><h3>Personal Information</h3>
      <div class="form-grid">
        <div class="field"><label for="fName">Full Name *</label><input class="input" id="fName" placeholder="Enter full name" required><span class="field-error"></span></div>
        <div class="field"><label for="fAge">Age *</label><select class="input select2" id="fAge" required><option value="" selected disabled>Select age</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fPhone">Phone Number</label><input class="input" id="fPhone" placeholder="03xx xxx xxxx" data-validate="phone"><span class="field-error"></span></div>
        <div class="field"><label for="fGender">Gender *</label><select class="input select2" id="fGender" required><option value="" selected disabled>Select gender</option><option>Female</option><option>Male</option><option>Other</option><option>Prefer not to say</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fRegion">Region</label><select class="input select2" id="fRegion"><option value="" selected disabled>Select region</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fLocalCouncil">Local Council</label><select class="input select2" id="fLocalCouncil"><option value="" selected disabled>Select local council</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fVillage">Village</label><select class="input select2" id="fVillage"><option value="" selected disabled>Select village</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fJk">JK / Attend</label><select class="input select2" id="fJk"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fEmployment">Employment / Education</label><select class="input select2" id="fEmployment"><option value="" selected disabled>Select status</option><option>Student</option><option>Employed</option><option>Self-employed</option><option>Unemployed</option><option>Not applicable</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fMarital">Marital Status</label><select class="input select2" id="fMarital"><option value="" selected disabled>Select marital status</option><option>Single</option><option>Married</option><option>Separated</option><option>Divorced</option><option>Widowed</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fLanguages">Language(s) Spoken</label><input class="input" id="fLanguages" placeholder="Languages"><span class="field-error"></span></div>
        <div class="field"><label for="fInsurance">Health Insurance</label><select class="input select2" id="fInsurance"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option><option>Unknown</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fGp">GP / Usual Source of Care</label><select class="input select2" id="fGp"><option value="" selected disabled>Select source</option><option>GP</option><option>Hospital</option><option>Clinic</option><option>Community Health Worker</option><option>None</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fPriorMh">Prior MH Treatment</label><select class="input select2" id="fPriorMh"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option><option>Unknown</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fConnectedMh">Connected to MH Care?</label><select class="input select2" id="fConnectedMh"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
      </div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" data-go="/Dashboard">Cancel</button>
        <button type="button" class="btn primary" id="rsNext1">Next</button>
      </div>
    </div>
  </div>

  <!-- STEP 2: Risk Assessment -->
  <div class="reg-step" id="rs2" hidden>
    <div class="card"><h3>Presenting Concern / History</h3>
      <div class="form-grid">
        <div class="field full"><label for="fConcern">Presenting Concern / History</label><textarea class="input" id="fConcern" placeholder="Free text"></textarea><span class="field-error"></span></div>
        <div class="field"><label for="fIsCrisis">Is this a Crisis?</label><select class="input select2" id="fIsCrisis"><option value="" selected disabled>Select option</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fRiskCat">Risk Category</label><select class="input select2" id="fRiskCat"><option value="" selected disabled>Select risk</option><option>Low</option><option>Moderate</option><option>High</option><option>Critical</option></select><span class="field-error"></span></div>
        <div class="field"><label for="fAssessor">Assessor Name</label><input class="input" id="fAssessor" placeholder="Free text"><span class="field-error"></span></div>
        <div class="field"><label for="fAssessTime">Time of Assessment</label><input class="input" type="date" id="fAssessTime"><span class="field-error"></span></div>
      </div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" id="rsBack2">Back</button>
        <button type="button" class="btn primary" id="rsNext2">Next</button>
      </div>
    </div>
  </div>

  <!-- STEP 3: Screening -->
  <div class="reg-step" id="rs3" hidden>
    <div class="card"><h3>Screening Tools</h3>
      <p style="margin-top:-8px">Tap a tool to complete its screening. You can complete multiple tools, or skip this step.</p>
      <div class="screen-tool-grid" id="screenToolCards"></div>
      <div class="field" style="margin-top:18px;max-width:320px">
        <label for="fPrelimRisk">Risk Level (Preliminary)</label>
        <select class="input select2" id="fPrelimRisk"><option>Low</option><option>Moderate</option><option>High</option></select>
        <span class="field-error"></span>
      </div>
      <div class="bottom-actions">
        <button type="button" class="btn secondary" id="rsBack3">Back</button>
        <button type="button" class="btn primary" id="rsNext3">Next</button>
      </div>
    </div>
  </div>

  <!-- Screening modal -->
  <div class="modal-backdrop" id="regScreenModal">
    <div class="modal" style="max-width:640px">
      <div class="modal-head">
        <h3 id="rsmTitle">Screening</h3>
        <button class="modal-x" data-close type="button" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body"><div id="rsmQuestions"></div></div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close type="button">Cancel</button>
        <button class="btn btn-primary" id="rsmComplete" type="button">Complete Screening</button>
      </div>
    </div>
  </div>

  <!-- STEP 4: Review & Submit -->
  <div class="reg-step" id="rs4" hidden>
    <div class="card"><h3>Personal Details</h3><div class="kv" id="revPersonal"></div></div>
    <div class="card"><h3>Reason for Referral</h3><p id="revConcern" style="margin:0"></p></div>
    <div class="card"><h3>Risk Assessment</h3><p id="revRisk" style="margin:0"></p></div>
    <div class="notice">This case will be assigned to the Case Management Officer (CMO) for further assessment and care coordination.</div>
    <div class="bottom-actions">
      <button type="button" class="btn secondary" id="rsBack4">Back</button>
      <button type="button" class="btn primary" id="rsSubmit">Submit Case</button>
    </div>
  </div>
</form>

@section Scripts {
<script src="~/js/screening-questions.js" asp-append-version="true"></script>
<script src="~/js/view/add-case.js" asp-append-version="true"></script>
}
