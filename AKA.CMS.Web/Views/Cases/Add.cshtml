@{
    ViewData["Title"] = "Register New Case";
    ViewData["ActivePage"] = "cases";
    ViewData["RequiredPermission"] = "Cases:Write";
}

<div class="page-head">
  <div class="page-title">
    <h1>Register New Case</h1>
    <p class="sub">Register the patient, create the case, then continue to screening</p>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="stepper" id="wizardStepper">
      <div class="step active" data-step="1"><span class="n">1</span><span class="t">Personal Information</span></div>
      <div class="step" data-step="2"><span class="n">2</span><span class="t">Case Information</span></div>
      <div class="step" data-step="3"><span class="n">3</span><span class="t">Review &amp; Submit</span></div>
    </div>

    <form id="wizardForm" data-validate novalidate>
      <div class="wizard-step active" id="s1">
        <div class="form-grid">
          <div class="field full"><label for="fName">Full name <span class="req">*</span></label><input class="input" id="fName" name="fullName" placeholder="Enter full name" required><span class="field-error"></span></div>
          <div class="field"><label for="fAge">Age <span class="req">*</span></label><select class="input select2" id="fAge" name="age" required><option value="">Select age&hellip;</option></select><span class="field-error"></span></div>
          <div class="field"><label for="fPhone">Phone number</label><input class="input" id="fPhone" name="phone" placeholder="03xx xxx xxxx" data-validate="phone"><span class="field-error"></span></div>
          <div class="field full"><label>Gender <span class="req">*</span></label><div class="gender-seg" id="fGenderSeg" role="radiogroup" aria-label="Gender"><button type="button" class="seg-btn" data-val="Male">Male</button><button type="button" class="seg-btn" data-val="Female">Female</button><button type="button" class="seg-btn" data-val="Other">Other</button></div><input type="hidden" id="fGender" name="gender" required><span class="field-error"></span></div>
          <div class="field"><label for="fRegion">Region council</label><input class="input" id="fRegion" name="regionCouncil" placeholder="Select region"><span class="field-error"></span></div>
          <div class="field"><label for="fLocalCouncil">Local council</label><input class="input" id="fLocalCouncil" name="localCouncil" placeholder="Select local council"><span class="field-error"></span></div>
          <div class="field"><label for="fVillage">Village</label><input class="input" id="fVillage" name="village" placeholder="Select village"><span class="field-error"></span></div>
          <div class="field"><label for="fJk">JK attend</label><input class="input" id="fJk" name="jkAttend" placeholder="Select JK"><span class="field-error"></span></div>
          <div class="field full"><label for="fEmployment">Employment / Education</label><input class="input" id="fEmployment" name="employmentEducation" placeholder="Employment / Education"><span class="field-error"></span></div>
          <div class="field"><label for="fMarital">Marital status</label><select class="input select2" id="fMarital" name="maritalStatus"><option value="">Select&hellip;</option><option>Single</option><option>Married</option><option>Divorced</option><option>Widowed</option><option>Separated</option></select><span class="field-error"></span></div>
          <div class="field"><label for="fChildren">No. of children</label><select class="input select2" id="fChildren" name="numberOfChildren"><option value="">Select&hellip;</option><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5+</option></select><span class="field-error"></span></div>
          <div class="field full"><label for="fLanguages">Which language(s) spoken</label><input class="input" id="fLanguages" name="languagesSpoken" placeholder="Languages"><span class="field-error"></span></div>
          <div class="field"><label for="fInsurance">Health insurance</label><select class="input select2" id="fInsurance" name="healthInsurance"><option value="">Select&hellip;</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
          <div class="field"><label for="fGp">GP/Usual source of care</label><input class="input" id="fGp" name="gpUsualCare" placeholder="Select"><span class="field-error"></span></div>
          <div class="field"><label for="fPriorMh">Prior MH treatment</label><select class="input select2" id="fPriorMh" name="priorMhTreatment"><option value="">Select&hellip;</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
          <div class="field"><label for="fConnectedMh">Connected to MH care?</label><select class="input select2" id="fConnectedMh" name="connectedToMhCare"><option value="">Select&hellip;</option><option>Yes</option><option>No</option></select><span class="field-error"></span></div>
          <div class="field full"><label for="fCareProvider">Name of care provider</label><input class="input" id="fCareProvider" name="careProviderName" placeholder="Care provider name"><span class="field-error"></span></div>
        </div>
      </div>

      <div class="wizard-step" id="s2">
        <div class="form-grid">
          <div class="field">
            <label for="fSource">Case source <span class="req">*</span></label>
            <select class="input select2" id="fSource" name="sourceType" required>
              <option value="">Select&hellip;</option>
              <option value="WalkIn">Walk-in</option>
              <option value="Referral">Referral</option>
              <option value="Helpline">Helpline</option>
              <option value="AwarenessSession">Awareness session</option>
              <option value="Screening">Community screening</option>
              <option value="Community">Community</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label for="fPriority">Priority</label>
            <select class="input select2" id="fPriority" name="priorityLevel">
              <option value="">Select&hellip;</option>
              <option>High</option>
              <option>Moderate</option>
              <option>Low</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="field full">
            <label for="fNotes">Notes</label>
            <textarea class="input" id="fNotes" name="notes" rows="3" placeholder="Reason for registration, presenting concerns&hellip;"></textarea>
            <span class="field-error"></span>
          </div>
        </div>
      </div>

      <div class="wizard-step" id="s3">
        <h3 class="step-h">Review &amp; submit</h3>
        <p class="sub">Please review the information before registering the case. After registration you will continue to the Screening page.</p>
        <div id="reviewBox" class="review-box"></div>
        <div class="field consent-field">
          <label class="check-row">
            <input type="checkbox" id="fConsent" name="consent" required>
            <span class="check-label">I confirm the patient has consented to registration and data processing. <span class="req">*</span></span>
          </label>
          <span class="field-error"></span>
        </div>
      </div>

      <div class="wizard-foot">
        <button class="btn btn-ghost" id="wizBack" type="button">Back</button>
        <button class="btn btn-primary" id="wizNext" type="button">Next</button>
        <button class="btn btn-accent" id="wizSubmit" type="button" hidden>Register Case</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script src="~/js/view/add-case.js" asp-append-version="true"></script>
}
