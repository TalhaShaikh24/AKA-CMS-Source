@{
    ViewData["Title"] = "Cases";
    ViewData["ActivePage"] = "cases";
}

<div class="page-head">
  <div class="page-title">
    <h1>Cases</h1>
    <p class="sub">Manage all registered cases across regions</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost" id="exportCsvBtn" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
      Export CSV
    </button>
    <a class="btn btn-primary" href="@Url.Action("Add", "Cases")">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Case
    </a>
  </div>
</div>

<div class="toolbar-row">
  <div class="search-wrap">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input class="input" type="search" id="caseSearch" placeholder="Search by name or case ID&hellip;" autocomplete="off">
  </div>
  <span class="results-count" id="caseCount"></span>
</div>

<div class="card">
  <div class="card-body flush">
    <div class="table-wrap">
      <table class="table" id="casesTable">
        <thead>
          <tr>
            <th>Case ID</th><th>Patient</th><th>Status</th><th>Priority</th><th>Created</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="empty" id="casesEmpty" hidden>No cases match your filters.</div>
  </div>
</div>

<div class="pagination" id="casePager"></div>

@section Scripts {
<script src="~/js/view/cases.js" asp-append-version="true"></script>
}
