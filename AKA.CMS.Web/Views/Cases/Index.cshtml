@{
    ViewData["Title"] = "My Cases";
    ViewData["Breadcrumb"] = "Workspace";
    ViewData["ActivePage"] = "cases";
    ViewData["RequiredPermission"] = "Cases:Read";
}

<div class="page-head">
  <div><h1>My Cases</h1><p>View and manage your assigned cases.</p></div>
</div>

<div class="filters">
  <input id="caseSearch" class="search" placeholder="Search by name, case ID or location">
  <select id="caseStatusFilter" class="filter-select"><option value="">All Status</option></select>
  <select id="caseRiskFilter" class="filter-select"><option value="">All Risk</option><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select>
</div>

<div class="card"><h3>Case Register</h3>
  <div class="table-wrap"><table class="table" id="caseTable">
    <thead><tr><th>Case ID</th><th>Patient</th><th>Age / Gender</th><th>Location</th><th>Risk</th><th>Status</th><th></th></tr></thead>
    <tbody id="caseRows"><tr><td colspan="7"><div class="empty">Loading&hellip;</div></td></tr></tbody>
  </table></div>
</div>

<div class="pagination" id="casePager"></div>

@section Scripts {
<script src="~/js/view/cases.js" asp-append-version="true"></script>
}
