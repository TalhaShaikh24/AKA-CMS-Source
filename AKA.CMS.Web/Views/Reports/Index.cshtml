@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "reports";
}
<style>
  .chart-wrap{position:relative;height:280px}
  .chart-wrap canvas{max-height:100%}
</style>

<div class="page-head">
  <div class="page-title">
    <h1>Reports</h1>
    <p class="sub">Programme performance and outcome indicators</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost filter-toggle-btn" id="filterToggle" type="button" aria-expanded="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.5 10 19 14 21 14 12.5 22 3"/></svg>
      Filters
      <span class="filter-count" id="filterCount" hidden>0</span>
    </button>
    <button class="btn btn-ghost" id="printBtn" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print
    </button>
    <button class="btn btn-accent" id="exportBtn" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
      Export CSV
    </button>
  </div>
</div>

<div class="filter-panel" id="repFilterPanel" hidden>
  <div class="filters-bar" id="reportFilters">
    <input class="input cms-daterange" id="repRange" placeholder="Select date range" autocomplete="off">
    <select class="input" id="fRegion">
      <option value="">All Regions</option>
      <option value="Skardu">Skardu</option>
      <option value="Gojal">Gojal</option>
      <option value="Hunza">Hunza</option>
      <option value="Ghizer">Ghizer</option>
      <option value="Booni">Booni</option>
    </select>
    <select class="input" id="fProgram">
      <option value="">All Programs</option>
      <option>Community Screening</option>
      <option>School Program</option>
      <option>Tele-psychiatry</option>
      <option>Crisis Response</option>
    </select>
  </div>
  <div class="filter-panel-foot">
    <button class="btn btn-ghost btn-sm" id="repClearFilters" type="button">Clear</button>
    <button class="btn btn-primary btn-sm" id="repApplyFilters" type="button">Apply Filters</button>
  </div>
</div>

<div class="kpi-grid k4">
  <div class="kpi-card">
    <div class="kpi-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg></div>
    <div class="kpi-label">Cases Registered</div>
    <div class="kpi-value">248</div>
    <div class="delta">+18 this month</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
    <div class="kpi-label">Screenings Completed</div>
    <div class="kpi-value">214</div>
    <div class="delta">+24 this month</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></div>
    <div class="kpi-label">Follow-up Adherence</div>
    <div class="kpi-value">82%</div>
    <div class="delta">+3 pts vs last quarter</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></div>
    <div class="kpi-label">Avg PHQ-9 Change</div>
    <div class="kpi-value">-4.2</div>
    <div class="delta">Improvement per case</div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head"><h3>Monthly Registrations</h3><span class="hint">Cases vs screenings</span></div>
    <div class="card-body"><div class="chart-wrap"><canvas id="repBar"></canvas></div></div>
  </div>
  <div class="card">
    <div class="card-head"><h3>Screening Mix</h3><span class="hint">By assessment tool</span></div>
    <div class="card-body"><div class="chart-wrap"><canvas id="repDonut"></canvas></div></div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h3>Case Summary</h3>
    <span class="hint">By region</span>
  </div>
  <div class="card-body">
    <table class="table" id="sumTable">
      <thead>
        <tr><th>Region</th><th>New</th><th>Active</th><th>High Risk</th><th>Follow-ups Due</th></tr>
      </thead>
      <tbody>
        <tr data-region="Skardu"><td><div class="cell-main">Skardu</div></td><td>64</td><td>52</td><td>9</td><td>21</td></tr>
        <tr data-region="Gojal"><td><div class="cell-main">Gojal</div></td><td>58</td><td>47</td><td>11</td><td>18</td></tr>
        <tr data-region="Hunza"><td><div class="cell-main">Hunza</div></td><td>49</td><td>38</td><td>7</td><td>14</td></tr>
        <tr data-region="Ghizer"><td><div class="cell-main">Ghizer</div></td><td>41</td><td>30</td><td>6</td><td>11</td></tr>
        <tr data-region="Booni"><td><div class="cell-main">Booni</div></td><td>36</td><td>27</td><td>4</td><td>9</td></tr>
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/view/reports.js" asp-append-version="true"></script>
}
