@{
    ViewData["Title"] = "Form Builder";
    ViewData["Breadcrumb"] = "System";
    ViewData["ActivePage"] = "dynamicforms";
    ViewData["RequiredPermission"] = "DynamicForms:Write";
    ViewData["HideChrome"] = true;
    var formId = ViewBag.FormId as int?;
}

@section Styles {
<style>
  /* Full-page editor: no sidebar/topbar (HideChrome), no content max-width
     or double padding — the builder owns the whole viewport. */
  @@media (min-width:1101px){
    #contentSlot{max-width:none;padding:0}
    #pageContent{max-width:none;padding:14px}
    .dfb-shell{height:calc(100vh - 28px);min-height:0}
  }
</style>
}

<input type="hidden" id="dfbFormId" value="@(formId?.ToString() ?? "")">

<div class="dfb-shell">
  <div class="dfb-toolbar">
    <a class="btn btn-ghost btn-sm" href="@Url.Action("Index", "DynamicForms")">← Forms</a>
    <input class="input dfb-tb-title" id="dfbTitle" placeholder="Form title — e.g. Intake Assessment">
    <input class="input dfb-tb-key" id="dfbKey" placeholder="form-key">
    <label class="check-row dfb-tb-active"><input type="checkbox" id="dfbActive" checked><span class="check-label">Active</span></label>
    <label class="check-row dfb-tb-active" title="Step (wizard) form — each Section becomes a step"><input type="checkbox" id="dfbMultiStep"><span class="check-label">Multi-step</span></label>
    <button class="btn btn-ghost btn-sm" id="dfbDescToggle" type="button">Description</button>
    <span class="dfb-tb-spacer"></span>
    <button class="btn btn-ghost" id="dfbNavToggle" type="button">⎇ Navigator</button>
    <button class="btn btn-ghost" id="dfbPreviewBtn" type="button">Preview</button>
    <button class="btn btn-primary" id="dfbSaveBtn" type="button">Save Form</button>
    <div class="dfb-tb-desc" id="dfbDescRow" hidden>
      <input class="input" id="dfbDesc" placeholder="What is this form for? (optional)">
    </div>
  </div>

  <div class="dfb-layout">
    <div class="card dfb-pane dfb-pane-pal" id="dfbPalPane">
      <div class="card-head"><h3>Fields</h3><button type="button" class="dfb-pal-toggle" id="dfbPalToggle" title="Collapse / expand the Fields panel">‹</button></div>
      <div class="card-body dfb-pane-body">
        <div id="dfbPalette"></div>
        <p class="hint" style="margin-top:10px">Drag a field onto the canvas, or click to add it.</p>
      </div>
    </div>

    <div class="card dfb-pane">
      <div class="card-head"><h3>Canvas</h3><span class="hint" id="dfbFieldCount"></span></div>
      <div class="card-body dfb-pane-body">
        <div class="dfb-canvas" id="dfbCanvas">
          <div class="dfb-stack" id="dfbGrid"></div>
          <div class="dfb-empty" id="dfbEmpty">Drop fields here to start building your form.</div>
        </div>
      </div>
    </div>

    <div class="card dfb-pane">
      <div class="card-head"><h3>Properties</h3><span class="hint" id="dfbPropsType"></span></div>
      <div class="card-body dfb-pane-body" id="dfbProps">
        <p class="hint">Select a field on the canvas to edit its properties.</p>
      </div>
    </div>
  </div>
</div>

<div class="dfb-navigator open" id="dfbNavigator">
  <div class="dfb-nav-head" id="dfbNavHead">
    <strong>Navigator</strong>
    <button type="button" class="modal-x" id="dfbNavClose" title="Close navigator">&times;</button>
  </div>
  <div class="dfb-nav-tree" id="dfbNavTree"></div>
  <p class="hint" style="padding:8px 12px;border-top:1px solid var(--border)">Click a row to select it on the canvas. Drag rows to reorder — sections move with all their fields.</p>
</div>

<div class="modal-backdrop" id="dfbPreviewModal">
  <div class="modal" style="max-width:900px">
    <div class="modal-head">
      <h3 id="dfbPreviewTitle">Form Preview</h3>
      <button class="modal-x" data-close type="button">&times;</button>
    </div>
    <div class="modal-body">
      <p class="hint" id="dfbPreviewDesc" style="margin-bottom:14px"></p>
      <div id="dfbPreviewBody"></div>
      <p class="hint" style="margin-top:16px">Preview of your current changes — the form is <strong>not saved yet</strong>. Close this and click “Save Form” when it looks right.</p>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" data-close type="button">Close</button>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/view/form-renderer.js" asp-append-version="true"></script>
<script src="~/js/view/form-builder.js" asp-append-version="true"></script>
}
