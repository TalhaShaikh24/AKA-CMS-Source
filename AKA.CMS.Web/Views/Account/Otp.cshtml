@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Enter OTP";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CMS · Enter OTP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
<style>
  .otp-row{display:flex;gap:12px;justify-content:center;margin:22px 0}
  .otp-box{width:56px;height:56px;border-radius:50%;border:2px solid var(--line,#dfe3e8);
    text-align:center;font-size:24px;font-weight:700;color:#1b2a4a;background:#f4f6fb;outline:none}
  .otp-box:focus{border-color:#1b2a4a;background:#fff}
  .otp-box.filled{border-color:#1b2a4a;background:#eef3fb}
  .resend{text-align:center;margin-top:16px}
</style>
</head>
<body class="auth-page">
@* Web API base URL for the global cmsAjax helper. *@
<script>window.CMS_API_BASE_URL = "@Configuration["ApiBaseUrl"]";</script>
<div class="auth-wrap">
  <div class="auth-brand">
    <div class="auth-brand-inner">
      <div class="auth-logo">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
          <circle cx="22" cy="22" r="20" fill="#DCE88A"/>
          <circle cx="22" cy="16" r="4.5" fill="#2E3D62"/>
          <circle cx="28.5" cy="22" r="4.5" fill="#2E3D62"/>
          <circle cx="22" cy="28" r="4.5" fill="#2E3D62"/>
          <circle cx="15.5" cy="22" r="4.5" fill="#2E3D62"/>
          <circle cx="22" cy="22" r="3.2" fill="#F4F6FB"/>
        </svg>
      </div>
      <h1>CASE MANAGEMENT SYSTEM</h1>
      <p class="auth-prog">Integrated Mental Health Programme</p>
    </div>
    <div class="mountains" aria-hidden="true"></div>
  </div>
  <div class="auth-card-wrap">
    <div class="auth-card">
      <h2>Enter OTP</h2>
      <p class="sub">Enter the 4 digit code sent to your email<br><strong id="otpEmailEcho"></strong></p>
      <form id="otpForm" novalidate>
        <div class="otp-row" id="otpRow">
          <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1">
          <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 2">
          <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 3">
          <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 4">
        </div>
        <p class="field-error" id="otpError" style="text-align:center"></p>
        <button type="submit" class="btn btn-primary btn-block">Continue</button>
        <p class="resend sub">Didn't get OTP? <a class="link" href="#" id="resendOtp">Resend OTP</a></p>
        <p class="sub" style="text-align:center;margin-top:14px"><a class="link" href="@Url.Action("Login", "Account")">&larr; Back to sign in</a></p>
      </form>
    </div>
  </div>
</div>
<div class="toast-wrap" id="toastWrap"></div>
<div class="loader" id="loader"><div class="spinner"></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/script.js" asp-append-version="true"></script>
<script src="~/js/ajax.js" asp-append-version="true"></script>
<script src="~/js/validation.js" asp-append-version="true"></script>
<script src="~/js/view/otp.js" asp-append-version="true"></script>
</body>
</html>
