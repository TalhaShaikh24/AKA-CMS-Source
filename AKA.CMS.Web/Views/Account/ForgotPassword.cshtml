@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CMS · Forgot Password</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body class="auth-page">
@* Web API base URL for the global cmsAjax helper. *@
<script>window.CMS_API_BASE_URL = "@Configuration["ApiBaseUrl"]";</script>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand-head">
      <img src="~/img/cmo-logo.png" asp-append-version="true" alt="Case Management System">
      <div class="line"></div>
      <h1>Forget password</h1>
      <p>Reset your password quickly and securely to regain access.</p>
    </div>
      <form id="forgotForm" data-validate novalidate>
        <div class="field">
          <label for="fpEmail">Email address <span class="req">*</span></label>
          <input class="input" type="email" id="fpEmail" name="email" placeholder="Enter your email" required autocomplete="email">
          <span class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Continue</button>
        <p class="sub" style="text-align:center;margin-top:14px"><a class="link" href="@Url.Action("Login", "Account")">&larr; Back to sign in</a></p>
      </form>
  </div>
</div>
<div class="toast-wrap" id="toastWrap"></div>
<div class="loader" id="loader"><div class="spinner"></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/script.js" asp-append-version="true"></script>
<script src="~/js/ajax.js" asp-append-version="true"></script>
<script src="~/js/validation.js" asp-append-version="true"></script>
<script src="~/js/view/forgot-password.js" asp-append-version="true"></script>
</body>
</html>
