@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CMS · Reset Password</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body class="auth-page">
@* Web API base URL for the global cmsAjax helper. *@
<script>window.CMS_API_BASE_URL = "@Configuration["ApiBaseUrl"]";</script>
<div class="auth-wrap">
  <div class="auth-brand">
    <div class="auth-brand-inner">
      <div class="auth-logo">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
          <circle cx="22" cy="22" r="20" fill="#DCE88A"/>
          <circle cx="22" cy="16" r="4.5" fill="#2E3D62"/>
          <circle cx="28.5" cy="22" r="4.5" fill="#2E3D62"/>
          <circle cx="22" cy="28" r="4.5" fill="#2E3D62"/>
          <circle cx="15.5" cy="22" r="4.5" fill="#2E3D62"/>
          <circle cx="22" cy="22" r="3.2" fill="#F4F6FB"/>
        </svg>
      </div>
      <h1>CASE MANAGEMENT SYSTEM</h1>
      <p class="auth-prog">Integrated Mental Health Programme</p>
    </div>
    <div class="mountains" aria-hidden="true"></div>
  </div>
  <div class="auth-card-wrap">
    <div class="auth-card">
      <h2>Set a new password</h2>
      <p class="sub">Choose a new password for your account (minimum 8 characters)</p>
      <div id="rpInvalid" hidden>
        <div class="callout callout-error">
          <strong>Invalid or missing reset link.</strong>
          <p class="sub">This reset link is not valid. Please request a new one.</p>
        </div>
        <p class="sub" style="text-align:center;margin-top:14px"><a class="link" href="@Url.Action("ForgotPassword", "Account")">Request a new reset link</a></p>
      </div>
      <form id="resetForm" data-validate novalidate hidden>
        <div class="field">
          <label for="rpPass">New password <span class="req">*</span></label>
          <input class="input" type="password" id="rpPass" name="newPassword" placeholder="Minimum 8 characters" required autocomplete="new-password" minlength="8">
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label for="rpPass2">Confirm new password <span class="req">*</span></label>
          <input class="input" type="password" id="rpPass2" name="confirmPassword" placeholder="Repeat the new password" required autocomplete="new-password">
          <span class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Set new password</button>
      </form>
    </div>
  </div>
</div>
<div class="toast-wrap" id="toastWrap"></div>
<div class="loader" id="loader"><div class="spinner"></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/script.js" asp-append-version="true"></script>
<script src="~/js/ajax.js" asp-append-version="true"></script>
<script src="~/js/validation.js" asp-append-version="true"></script>
<script src="~/js/view/reset-password.js" asp-append-version="true"></script>
</body>
</html>
