@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var activePage = (string?)ViewData["ActivePage"] ?? "";
    var hideChrome = ViewData["HideChrome"] as bool? == true;
    string NavCls(string key) => key == activePage ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@(ViewData["Title"] ?? "CMS") · CMS — Integrated Mental Health Programme</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
@await RenderSectionAsync("Styles", required: false)
</head>
<body data-page="@activePage" data-required-permission="@ViewData["RequiredPermission"]">
@* The Web API base URL comes from appsettings ("ApiBaseUrl").
   The global cmsAjax helper prefixes every /api/... call with it. *@
<script>window.CMS_API_BASE_URL = "@Configuration["ApiBaseUrl"]";</script>
<div class="app" id="app">
  @if (!hideChrome)
  {
  <aside class="sidebar">
    <div class="brand">
      <img src="~/img/cmo-logo.png" asp-append-version="true" alt="Case Management System — Integrated Mental Health Programme">
    </div>
    <nav class="nav">
      <div class="nav-label">Workspace</div>
      <a href="@Url.Action("Index", "Dashboard")" class="@NavCls("dashboard")" data-key="dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>Dashboard</span>
      </a>
      <a href="@Url.Action("Index", "Cases")" class="@NavCls("cases")" data-key="cases" data-permission="Cases:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        <span>My Cases</span>
      </a>
      <a href="@Url.Action("Index", "Appointments")" class="@NavCls("appointments")" data-key="appointments">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M8 2.5v4M16 2.5v4M3 10h18"/></svg>
        <span>Follow-ups</span>
      </a>
      <a href="@Url.Action("Index", "Screening")" class="@NavCls("screening")" data-key="screening" data-permission="Screenings:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4a3 3 0 0 1 6 0M9.5 13l2 2 3.5-4"/></svg>
        <span>Screening</span>
      </a>
      <a href="@Url.Action("Index", "Tasks")" class="@NavCls("tasks")" data-key="tasks" data-permission="Tasks:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <span>Tasks &amp; Assignments</span>
      </a>
      <a href="@Url.Action("Index", "Referrals")" class="@NavCls("referrals")" data-key="referrals" data-permission="Referrals:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
        <span>Referrals</span>
      </a>
      <div class="nav-label">Case</div>
      <a href="@Url.Action("Add", "Cases")" class="@NavCls("cases-add")" data-key="cases-add" data-permission="Cases:Write">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <span>Register New Case</span>
      </a>
      <a href="@Url.Action("Index", "SafetyPlans")" class="@NavCls("safety-plan")" data-key="safety-plan" data-permission="SafetyPlans:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9.5 12l2 2 3.5-4"/></svg>
        <span>Safety Plans</span>
      </a>
      <a href="@Url.Action("Index", "TreatmentPlans")" class="@NavCls("treatment-plan")" data-key="treatment-plan" data-permission="TreatmentPlans:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S4 15.5 4 9.8A4.3 4.3 0 0 1 8.2 5.5c1.7 0 3 .9 3.8 2.3a4.7 4.7 0 0 1 3.8-2.3A4.3 4.3 0 0 1 20 9.8c0 5.7-8 10.7-8 10.7z"/></svg>
        <span>Treatment Plans</span>
      </a>
      <div class="nav-label">System</div>
      <a href="@Url.Action("Index", "Users")" class="@NavCls("users")" data-key="users" data-permission="Users:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.8a3.5 3.5 0 0 1 0 6.4M17.5 14.5a6.5 6.5 0 0 1 4 5.5"/></svg>
        <span>Users</span>
      </a>
      <a href="@Url.Action("Index", "Roles")" class="@NavCls("roles")" data-key="roles" data-permission="Roles:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3m-4 2 3 3"/></svg>
        <span>Roles &amp; Permissions</span>
      </a>
      <a href="@Url.Action("Index", "ScreeningTools")" class="@NavCls("screeningtools")" data-key="screeningtools" data-permission="Screenings:Write">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <span>Screening Tools</span>
      </a>
      <a href="@Url.Action("Index", "Reports")" class="@NavCls("reports")" data-key="reports" data-permission="Reports:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>
        <span>Reports</span>
      </a>
      <a href="@Url.Action("Index", "Facilities")" class="@NavCls("facilities")" data-key="facilities" data-permission="Facilities:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-4h6v4M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg>
        <span>Facilities</span>
      </a>
      <a href="@Url.Action("Index", "Geography")" class="@NavCls("geography")" data-key="geography" data-permission="Geography:Read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span>Geography</span>
      </a>
      <a href="@Url.Action("Index", "Settings")" class="@NavCls("settings")" data-key="settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg>
        <span>Settings</span>
      </a>
    </nav>
    <div class="role-badge">
      <div class="avatar" id="cmsUserAvatarSide">?</div>
      <div><strong id="cmsUserName">…</strong><span id="cmsUserRoles">Team member</span></div>
    </div>
  </aside>
  }
  <div class="main">
    @if (!hideChrome)
    {
    <header class="topbar">
      <button class="icon-btn nav-toggle" id="navToggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <div class="topbar-title">
        <div class="breadcrumb">@(ViewData["Breadcrumb"] ?? "Workspace")</div>
        <div class="top-title">@(ViewData["Title"] ?? "CMS")</div>
      </div>
      <div class="topbar-actions">
        <button class="icon-btn" id="notifBtn" aria-label="Notifications">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <span class="dot" id="notifDot" hidden></span>
        </button>
        <div class="profile-menu">
          <button type="button" class="profile" id="profileMenuBtn" aria-haspopup="true" aria-expanded="false">
            <div class="avatar" id="cmsUserAvatar">?</div>
          </button>
          <div class="profile-dropdown" id="profileDropdown" hidden>
            <a class="dd-item" href="@Url.Action("Profile", "Users")">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Edit profile
            </a>
            <button type="button" class="dd-item" id="logoutBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
              Sign out
            </button>
          </div>
        </div>
      </div>
    </header>
    }
    <div class="content" id="contentSlot">
      <main class="content" id="pageContent">
        @RenderBody()
      </main>
    </div>
  </div>
  <div class="overlay" id="navOverlay"></div>
</div>
<div class="toast-wrap" id="toastWrap"></div>
<div class="loader" id="loader"><div class="spinner"></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="~/js/script.js" asp-append-version="true"></script>
<script src="~/js/ajax.js" asp-append-version="true"></script>
<script src="~/js/auth-guard.js" asp-append-version="true"></script>
<script src="~/js/validation.js" asp-append-version="true"></script>
<script src="~/js/validator.js" asp-append-version="true"></script>
<script src="~/js/screening-tools-loader.js" asp-append-version="true"></script>
<script src="~/js/filters.js" asp-append-version="true"></script>
<script>
// Fills the user chip from the JWT login session stored by cmsAuth.
(function () {
    var user = window.cmsAuth && window.cmsAuth.getUser ? window.cmsAuth.getUser() : null;
    var name = (user && (user.username || user.userName)) || 'Team member';
    var roles = (user && user.roles && user.roles.length) ? user.roles.join(', ') : 'Team member';
    ['cmsUserName'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.textContent = name;
    });
    var r = document.getElementById('cmsUserRoles');
    if (r) r.textContent = roles;
    var av = document.getElementById('cmsUserAvatar');
    if (av) av.textContent = name.length >= 2 ? name.substring(0, 2).toUpperCase() : '?';
    var avSide = document.getElementById('cmsUserAvatarSide');
    if (avSide) avSide.textContent = name.length >= 2 ? name.substring(0, 2).toUpperCase() : '?';
    var lb = document.getElementById('logoutBtn');
    if (lb) lb.addEventListener('click', function () { window.cmsAuth.logout(); });
    // Avatar dropdown: Edit profile / Sign out.
    var menuBtn = document.getElementById('profileMenuBtn');
    var menu = document.getElementById('profileDropdown');
    if (menuBtn && menu) {
        menuBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = menu.hidden;
            menu.hidden = !open;
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        document.addEventListener('click', function (e) {
            if (!menu.hidden && !menu.contains(e.target)) {
                menu.hidden = true;
                menuBtn.setAttribute('aria-expanded', 'false');
            }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !menu.hidden) {
                menu.hidden = true;
                menuBtn.setAttribute('aria-expanded', 'false');
            }
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
