{
  "info": {
    "name": "AKA-CMS API",
    "_postman_id": "aka-cms-sprint10-handoff",
    "description": "Happy-path collection for the AKA-CMS backend (Sprints 0-10).\n\nRun order: 01 Auth first (Login stores {{token}} and {{refreshToken}}), then the folders in order. Several requests store ids (caseId, rowVersion) as collection variables for later steps; others use {{placeholders}} you fill from earlier responses.\n\nBase URL and credentials live in collection variables \u2014 edit them, not every request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "memberId",
      "value": "REPLACE_ME"
    },
    {
      "key": "caseId",
      "value": "REPLACE_ME"
    },
    {
      "key": "rowVersion",
      "value": "REPLACE_ME"
    },
    {
      "key": "referralId",
      "value": "REPLACE_ME"
    },
    {
      "key": "psychPlanId",
      "value": "REPLACE_ME"
    },
    {
      "key": "pharmPlanId",
      "value": "REPLACE_ME"
    },
    {
      "key": "prescriptionId",
      "value": "REPLACE_ME"
    },
    {
      "key": "sessionId",
      "value": "REPLACE_ME"
    },
    {
      "key": "followUpId",
      "value": "REPLACE_ME"
    },
    {
      "key": "closureId",
      "value": "REPLACE_ME"
    },
    {
      "key": "notificationId",
      "value": "REPLACE_ME"
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api/auth/login"
              ]
            },
            "description": "Sprint 0: returns accessToken + refreshToken; stores them as variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Dev@Admin#2026\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", j.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api/auth/refresh"
              ]
            },
            "description": "Sprint 0: exchanges the refresh token for a new pair.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", j.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api/auth/logout"
              ]
            },
            "description": "Sprint 0: revokes the refresh token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api/health"
              ]
            },
            "description": "Sprint 10: liveness probe, anonymous."
          },
          "response": []
